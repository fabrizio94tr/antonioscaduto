# ===== Obbligatorie =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # chiave "anon" (mai la service_role!)
NEXT_PUBLIC_SITE_URL=https://www.antonioscaduto.com

# ===== Opzionali: ogni funzione si attiva da sola quando la variabile è presente =====
FOOTBALL_DATA_KEY=                # pagina /risultati (chiave gratuita su football-data.org)
RESEND_API_KEY=                   # invio newsletter (resend.com)
# Assistente AI (titolo SEO, meta description, tag): basta UNA delle due chiavi
OPENAI_API_KEY=                   # ChatGPT / OpenAI (modello: OPENAI_MODEL, default gpt-4o-mini)
ANTHROPIC_API_KEY=                # alternativa: Claude
AI_PROVIDER=                      # facoltativo: "openai" o "anthropic" se le hai messe entrambe
NEXT_PUBLIC_VAPID_PUBLIC_KEY=     # notifiche push: genera la coppia con `npx web-push generate-vapid-keys`
VAPID_PRIVATE_KEY=
VAPID_CONTACT=info@antonioscaduto.com
